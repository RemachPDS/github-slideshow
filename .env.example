# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/mirror_engine"

# Groq (gratuito en console.groq.com)
GROQ_API_KEY="gsk_..."

# Telegram Bot (crear en @BotFather)
TELEGRAM_BOT_TOKEN="123456:ABC..."
# Registrar webhook: GET https://api.telegram.org/bot{TOKEN}/setWebhook?url={APP_URL}/api/telegram
NEXT_PUBLIC_TELEGRAM_BOT_NAME="MirrorEngineBot"

# Auth (next-auth v5)
AUTH_SECRET="generate with: openssl rand -base64 32"

# OAuth providers (use at least one)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
